<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainScreenButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/main_screen_button_def_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/main_screen_button_background</item>
        <item name="android:textColor">@color/main_screen_button_text</item>
        <item name="android:textSize">@dimen/text_size_main_screen</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/main_screen_button_rounding</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/main_screen_button_text</item>
        <item name="iconPadding">@dimen/main_screen_button_icons_padding</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="MainScreenMainLayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/main_screen_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="ActivityMainLayoutStyle">
        <item name="android:background">@color/activity_background</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsItemTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:textColor">@color/settings_item_text</item>
        <item name="android:textSize">@dimen/text_size_settings_screen</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="SettingsItemIconStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:tint">@color/settings_item_icon</item>
    </style>

    <style name="ScreenTitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:textColor">@color/screen_title</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="BackArrowStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:tintMode">src_in</item>
        <item name="android:tint">@color/screen_title</item>
        <item name="android:src">@drawable/ic_back_arrow_16</item>
    </style>

    <style name="ActionButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/action_button_color</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/action_button_text_color</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">@dimen/action_button_rounding</item>
    </style>
</resources>