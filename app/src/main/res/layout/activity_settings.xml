<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ActivityMainLayoutStyle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp">

        <ImageView
            android:id="@+id/back_from_settings_button"
            android:contentDescription="@string/back_arrow_cd"
            style="@style/BackArrowStyle" />

        <TextView
            android:text="@string/settings_screen_title"
            style="@style/ScreenTitleStyle" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="33dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="15dp"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/settings_list_vertical_margin">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/theme_switcher" />

            <Switch
                android:id="@+id/simple_switch"
                style="@style/SettingsSwitchStyle" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/settings_list_vertical_margin">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/share" />

            <ImageView
                android:id="@+id/share_button"
                style="@style/SettingsItemIconStyle"
                android:src="@drawable/share"
                android:contentDescription="@null"/>

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/settings_list_vertical_margin">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/support" />

            <ImageView
                android:id="@+id/contact_support_button"
                style="@style/SettingsItemIconStyle"
                android:src="@drawable/support"
                android:contentDescription="@null"/>

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/settings_list_vertical_margin">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/license_agreement" />

            <ImageView
                android:id="@+id/license_agreement_button"
                style="@style/SettingsItemIconStyle"
                android:src="@drawable/arrow_forward"
                android:contentDescription="@null"/>

        </FrameLayout>

    </LinearLayout>
</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>