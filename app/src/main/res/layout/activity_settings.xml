<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ActivityMainLayoutStyle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp">

        <ImageView
            android:id="@+id/back_from_settings_button"
            android:contentDescription="@string/back_arrow_cd"
            style="@style/BackArrowStyle" />

        <TextView
            android:text="@string/settings_screen_title"
            style="@style/ScreenTitleStyle" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="33dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="15dp"
        android:orientation="vertical">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/themeSwitcher"
            android:layout_marginVertical="@dimen/settings_list_vertical_margin"
            android:minHeight="0dp"
            android:text="@string/theme_switcher"
            android:textSize="@dimen/text_size_settings_screen"
            android:textColor="@color/settings_item_text"
            android:fontFamily="@font/ys_display_regular"
            android:layout_gravity="start|center_vertical"
            android:layout_marginHorizontal="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/settings_list_vertical_margin">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/share" />

            <ImageView
                android:id="@+id/share_button"
                style="@style/SettingsItemIconStyle"
                android:src="@drawable/ic_share_button_24"
                android:contentDescription="@null"/>

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/settings_list_vertical_margin">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/support" />

            <ImageView
                android:id="@+id/contact_support_button"
                style="@style/SettingsItemIconStyle"
                android:src="@drawable/ic_support_button_24"
                android:contentDescription="@null"/>

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/settings_list_vertical_margin">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/license_agreement" />

            <ImageView
                android:id="@+id/license_agreement_button"
                style="@style/SettingsItemIconStyle"
                android:src="@drawable/ic_forward_arrow_24"
                android:contentDescription="@null"/>

        </FrameLayout>

    </LinearLayout>
</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>