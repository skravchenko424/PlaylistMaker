<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trackLayout"
    android:layout_width="match_parent"
    android:layout_height="61dp"
    android:background="@color/activity_background"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingStart="13dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/track_image"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_album_image_placeholder_45" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/track_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/track_name"
            android:textSize="@dimen/track_title_text_size"
            android:fontFamily="@font/ys_display_regular"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Smells Like Teen Spirit" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/artist_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/track_info"
                android:layout_gravity="fill_horizontal"
                android:textSize="@dimen/track_info_text_size"
                android:layout_weight="1"
                android:fontFamily="@font/ys_display_regular"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Nirvana" />

            <ImageView
                android:id="@+id/track_delimiter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                app:tint="@color/track_info"
                android:src="@drawable/ic_track_view_delimiter_13"
                android:contentDescription="@null"
                 />

            <TextView
                android:id="@+id/track_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/track_info"
                android:layout_gravity="fill_horizontal"
                android:layout_marginEnd="1dp"
                android:textSize="@dimen/track_info_text_size"
                android:fontFamily="@font/ys_display_regular"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="5:01" />

        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/track_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        app:tint="@color/track_info"
        android:src="@drawable/ic_forward_arrow_24" />

</LinearLayout>